// WebDAV storage provider — the rut port of the apiVersion 1 TS backend
// (`src/backend.ts`), now the phase-4b pkg tree. This file is the ROOT:
// `entry fn start(cx)` constructs the emp services FROM the boot handle
// and binds every op to a plain fn; the dispatch entry is the two-line
// forward over `Rpc.dispatch` (this backend serves no binary ops, so
// there is no `rpc_bin` twin). The implementation mounts as siblings:
//
//   model    — the module state record (session pool + challenge cache)
//   strutil  — pure string scans (casing, trims, ordering, hex)
//   url      — percent-encode/decode + address splitting + URL joins
//   config   — the per-instance KV document + the secret key + creds
//   auth     — Basic / Digest (MD5, MD5-sess, qop=auth) + challenge cache
//   dav      — the `net::fetch` core + challenge/retry + error mapping
//   props    — the PROPFIND multistatus decode + listing-row mapping
//   listing  — `storage:list` (PROPFIND → sort → JSON array)
//   session  — the chunked-pull sessions (open probe / chunk / release)
//   ops      — the bound handlers (raw args in, raw payload out)
//
// Multi-instance: each configured WebDAV server is one *instance* named
// `webdav:<uuid>` (the storage row's `plugin_storage_id`). Per-instance
// config lives in `Db` (this plugin's KV) under `storage:<instance>` =
// JSON `{ alias, addr, username, isAnonymous, secretId }` (the exact key
// names the TS wrote — legacy configs stay readable); the password lives
// in `Secret` under that `secretId` (scope `plugin:com.ease.webdav`).
// The host's payloads still carry `storageId` — the instance multiplexer;
// the PLUGIN identity rides the minted handle now, not the payload.
//
// Error contract: handlers TRAP with messages prefixed `UNAUTHORIZED` /
// `TIMEOUT` where the failure is one — the host maps those heads to typed
// errors; the `{"ok":…}` envelope is built host-side from the value/trap.
//
// The boot law: `start` constructs services and binds ops only — no
// Android-only rows, no network (construction just stores the handle).

use emp::{ Context, Db, Rpc, Secret };

mod auth;
mod config;
mod dav;
mod listing;
mod model;
mod ops;
mod props;
mod session;
mod strutil;
mod url;

// The boot: construct the services FROM the handle and bind every op —
// nothing else (the new contract's start answers nothing).
entry fn start(cx: opaque) {
    const db = Db(cx);
    const secret = Secret(cx);
    const context = Context(cx);
    const rpc = Rpc(cx);
    const c = model::new_ctx();
    rpc.bind("storage:list", fn (args: str) -> ?str {
        return ops::storage_list(db, secret, c, args);
    });
    rpc.bind("storage:get", fn (args: str) -> ?str {
        return ops::storage_get(db, secret, c, args);
    });
    rpc.bind("storage:get-chunk", fn (args: str) -> ?str {
        return ops::storage_get_chunk(db, secret, c, args);
    });
    rpc.bind("storage:release", fn (args: str) -> ?str {
        return ops::storage_release(c, args);
    });
    rpc.bind("storage:removeInstance", fn (args: str) -> ?str {
        return ops::storage_remove_instance(db, secret, context, c, args);
    });
    rpc.bind("webdav:test", fn (args: str) -> ?str {
        return ops::webdav_test(db, secret, c, args);
    });
    rpc.bind("webdav:connect", fn (args: str) -> ?str {
        return ops::webdav_connect(db, secret, args);
    });
}

// The str dispatch entry (declared once per backend) — a two-line forward
// over the bind table.
entry fn rpc(cx: opaque, op: str, args: str) -> ?str {
    const rpc = Rpc(cx);
    return rpc.dispatch(op, args);
}
