// view/form.rut — the form's visual pieces: labeled text fields (the
// bordered boxes), the anonymous-login toggle, the ghost/primary buttons,
// and the status line. The palette is static slate + indigo
// (0xRRGGBBAA — the kit's packing law): theme colors are an Android-only
// row and views must boot headless (the check harness), so there is no
// `themes` here. The palette consts are pub — the root's derives (the
// toggle's fill) read them.

use tur_kit::control_flow::control::{ Condition };
use tur_kit::flags::{ BorderPosition, CrossAlign, MainAlign, MainAxisSize };
use tur_kit::gesture::pointer::{ PointerInteract };
use tur_kit::handles::{ TextCtrl, UndoCtrl, View };
use tur_kit::layout::box::{ Container, SizedBox };
use tur_kit::layout::flex::{ Column, Row };
use tur_kit::reactive::{ Mutation, Readable, sv };
use tur_kit::text::core::{ Text };
use tur_kit::text::input::{ Input };

// the static palette
pub let PRIMARY: u64 = 0x4F46E5FFu64;
pub let CARD: u64 = 0xFFFFFFFFu64;
let TEXT: u64 = 0xFF1E293Bu64;
let TEXT_MUTED: u64 = 0xFF64748Bu64;
let DIVIDER: u64 = 0xFFE2E8F0u64;
let ERROR: u64 = 0xFFDC2626u64;

pub fn field_label(text: str) -> View {
    return Text()
        .text(sv(text))
        .font_size(13.0)
        .color(TEXT_MUTED)
        .build();
}

pub fn text_field(ctrl: TextCtrl, undo: UndoCtrl, placeholder: Readable<str>, obscure: bool) -> View {
    // the masked twin spells its own chain (construction is chained, never
    // statement-mutated — `obscure` is a lane on the same builder)
    if (obscure) {
        let input = Input()
            .controller(ctrl)
            .undo(undo)
            .placeholder(placeholder)
            .obscure(sv(true))
            .font_size(15.0)
            .color(TEXT)
            .cursor_color(PRIMARY)
            .width_height(0.0, 22.0)
            .build();
        return field_box(input);
    }
    let input = Input()
        .controller(ctrl)
        .undo(undo)
        .placeholder(placeholder)
        .font_size(15.0)
        .color(TEXT)
        .cursor_color(PRIMARY)
        .width_height(0.0, 22.0)
        .build();
    return field_box(input);
}

/// The bordered field box around a built input.
fn field_box(input: View) -> View {
    return Container()
        .color(sv(CARD))
        .border(DIVIDER, 1.0, BorderPosition::Inside)
        .radius(sv(12.0f64))
        .padding(10.0)
        .child(input)
        .build();
}

/// The "匿名登录" toggle row (the box fills when on).
pub fn anonymous_toggle(anonymous: Readable<bool>, fill: Readable<u64>, b_toggle: Mutation<nil>) -> View {
    let on_label = Text()
        .text(sv("匿名登录"))
        .font_size(14.0)
        .color(TEXT)
        .build();
    let off_label = Text()
        .text(sv("匿名登录"))
        .font_size(14.0)
        .color(TEXT_MUTED)
        .build();
    return PointerInteract()
        .on_click(b_toggle)
        .query_key("webdav-anon")
        .child(
            Row()
                .main_alignment(MainAlign::Start)
                .cross_alignment(CrossAlign::Center)
                .main_axis_size(MainAxisSize::Min)
                .child(
                    Container()
                        .width_height(18.0, 18.0)
                        .radius(sv(5.0f64))
                        .border(DIVIDER, 1.0, BorderPosition::Inside)
                        .color(fill)
                        .build(),
                )
                .child(SizedBox(8.0, 0.0).build())
                .child(
                    Condition(anonymous)
                        .then(on_label)
                        .else_branch(off_label)
                        .build(),
                )
                .build(),
        )
        .build();
}

pub fn ghost_button(key: str, label: str, cb: Mutation<nil>) -> View {
    let face = Container()
        .radius(sv(24.0f64))
        .padding(14.0)
        .color(sv(CARD))
        .border(PRIMARY, 1.0, BorderPosition::Inside)
        .child(
            Text()
                .text(sv(label))
                .font_size(15.0)
                .color(PRIMARY)
                .build(),
        )
        .build();
    return PointerInteract()
        .on_click(cb)
        .query_key(key)
        .child(face)
        .build();
}

pub fn primary_button(key: str, label: Readable<str>, cb: Mutation<nil>) -> View {
    let face = Container()
        .radius(sv(24.0f64))
        .padding(14.0)
        .color(sv(PRIMARY))
        .child(
            Text()
                .text(label)
                .font_size(15.0)
                .color(0xFFFFFFFFu64)
                .build(),
        )
        .build();
    return PointerInteract()
        .on_click(cb)
        .query_key(key)
        .child(face)
        .build();
}

/// The status line: the message rides its source, the tint swaps on
/// `status_is_error` (Text.color is a static lane).
pub fn status_area(status_text: Readable<str>, status_visible: Readable<bool>, status_is_error: Readable<bool>) -> View {
    let err = Text()
        .text(status_text)
        .font_size(13.0)
        .color(ERROR)
        .query_key("webdav-status")
        .build();
    let muted = Text()
        .text(status_text)
        .font_size(13.0)
        .color(TEXT_MUTED)
        .query_key("webdav-status")
        .build();
    return Condition(status_visible)
        .then(
            Condition(status_is_error)
                .then(err)
                .else_branch(muted)
                .build(),
        )
        .else_branch(SizedBox(0.0, 0.0).build())
        .build();
}
