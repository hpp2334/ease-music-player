// view/actions.rut — the connect/edit form's action helpers: the field
// validation (the TS `validate`, same messages), the edit-mode hydration
// (the stored `storage:<id>` KV document prefilling the controllers), the
// `webdav:test` / `webdav:connect` arg builders, and the reply parsers.
// The replies arrive as the host-built `{"ok":…}` envelope — unchanged
// shape from the apiVersion 2 view, only now built host-side from the
// handler's value/trap.

use emp::{ Db };
use json::{ JsonReader, JsonWriter };

/// The prefilled config (the edit-mode hydration document).
pub struct StoredConfig {
    alias: str,
    addr: str,
    username: str,
    is_anonymous: bool,
}

pub struct TestReply {
    ok: bool,
    message: str,
    outcome: str,
}

pub struct ConnectReply {
    ok: bool,
    message: str,
    storage_id: str,
    created: bool,
}

// ---- the shared field helpers -------------------------------------------

pub fn trim(s: str) -> str {
    let n = s.len();
    let a = 0;
    while (a < n && is_ws(s.code_at(a))) {
        a += 1;
    }
    let b = n;
    while (b > a && is_ws(s.code_at(b - 1))) {
        b -= 1;
    }
    return s.slice(a, b);
}

fn is_ws(c: u32) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13;
}

/// The "" = create spelling of the mode source.
pub fn sid_opt(sid: str) -> ?str {
    if (sid == "") {
        return nil;
    }
    return sid;
}

/// The connect-form validation (the TS `validate`, same messages).
pub fn validate(addr: str, alias: str, is_anon: bool, username: str, password: str, is_edit: bool) -> str {
    if (addr == "") {
        return "服务器地址不能为空";
    }
    if (alias == "") {
        return "服务器名称 (别名) 不能为空";
    }
    if (!is_anon && username == "") {
        return "用户名不能为空";
    }
    if (!is_anon && password == "" && !is_edit) {
        return "密码不能为空";
    }
    return "";
}

// ---- the edit-mode hydration ---------------------------------------------

/// Read the stored `storage:<id>` document; nil when missing/corrupt (the
/// hydration starts blank). The CALLER writes the controllers — it owns
/// the mutation ctx.
pub fn stored_config(db: Db, sid: str) -> ?StoredConfig {
    let raw = db.get(f"storage:{sid}");
    if (raw == nil) {
        return nil;
    }
    let doc: str = raw;
    return decode_config(doc);
}

/// Decode the persisted config document; nil on corrupt JSON.
fn decode_config(doc: str) -> ?StoredConfig {
    let r = JsonReader::of(doc);
    r.begin_object();
    let alias = "";
    let addr = "";
    let username = "";
    let anon = false;
    while (r.more()) {
        let k = r.next_key();
        if (r.failed()) {
            return nil;
        }
        when (k) {
            "alias" -> {
                let v = r.read_str();
                if (r.failed()) { return nil; }
                alias = v;
            },
            "addr" -> {
                let v = r.read_str();
                if (r.failed()) { return nil; }
                addr = v;
            },
            "username" -> {
                let v = r.read_str();
                if (r.failed()) { return nil; }
                username = v;
            },
            "isAnonymous" -> {
                anon = r.read_bool();
            },
            else -> { r.skip_value(); },
        }
        if (r.failed()) {
            return nil;
        }
    }
    r.end_object();
    if (r.failed()) {
        return nil;
    }
    return StoredConfig { alias: alias, addr: addr, username: username, is_anonymous: anon };
}

// ---- the backend calls (arg building + envelope parsing) ------------------

pub fn test_args(storage_id: ?str, addr: str, username: str, password: str, is_anon: bool) -> str {
    let w = JsonWriter::new();
    w.begin_object();
    if (storage_id != nil) {
        let s: str = storage_id;
        w.key("storageId");
        w.write_str(s);
    }
    w.key("addr");
    w.write_str(addr);
    w.key("username");
    w.write_str(username);
    w.key("password");
    w.write_str(password);
    w.key("isAnonymous");
    w.write_bool(is_anon);
    w.end_object();
    return w.finish();
}

pub fn connect_args(storage_id: ?str, addr: str, alias: str, username: str, password: str, is_anon: bool) -> str {
    let w = JsonWriter::new();
    w.begin_object();
    if (storage_id != nil) {
        let s: str = storage_id;
        w.key("storageId");
        w.write_str(s);
    }
    w.key("addr");
    w.write_str(addr);
    w.key("alias");
    w.write_str(alias);
    w.key("username");
    w.write_str(username);
    w.key("password");
    w.write_str(password);
    w.key("isAnonymous");
    w.write_bool(is_anon);
    w.end_object();
    return w.finish();
}

/// `{"ok":true,"result":{"result":"SUCCESS"}}` / `{"ok":false,"error":"…"}`.
pub fn parse_test_reply(reply: str) -> TestReply {
    let r = JsonReader::of(reply);
    r.begin_object();
    let ok = false;
    let have_ok = false;
    let message = "";
    let outcome = "OTHER_ERROR";
    while (r.more()) {
        let k = r.next_key();
        if (r.failed()) {
            break;
        }
        if (k == "ok") {
            ok = r.read_bool();
            have_ok = true;
        } else if (k == "error") {
            let v = r.read_str();
            if (!r.failed()) {
                message = v;
            }
        } else if (k == "result") {
            r.begin_object();
            while (r.more()) {
                let rk = r.next_key();
                if (r.failed()) {
                    break;
                }
                if (rk == "result") {
                    let v = r.read_str();
                    if (!r.failed()) {
                        outcome = v;
                    }
                } else {
                    r.skip_value();
                }
            }
            r.end_object();
        } else {
            r.skip_value();
        }
    }
    if (!have_ok) {
        return TestReply { ok: false, message: "后台未响应", outcome: "OTHER_ERROR" };
    }
    return TestReply { ok: ok, message: message, outcome: outcome };
}

/// `{"ok":true,"result":{"storageId":"…","created":true}}` / the error shape.
pub fn parse_connect_reply(reply: str) -> ConnectReply {
    let r = JsonReader::of(reply);
    r.begin_object();
    let ok = false;
    let have_ok = false;
    let message = "";
    let storage_id = "";
    let created = false;
    while (r.more()) {
        let k = r.next_key();
        if (r.failed()) {
            break;
        }
        if (k == "ok") {
            ok = r.read_bool();
            have_ok = true;
        } else if (k == "error") {
            let v = r.read_str();
            if (!r.failed()) {
                message = v;
            }
        } else if (k == "result") {
            r.begin_object();
            while (r.more()) {
                let rk = r.next_key();
                if (r.failed()) {
                    break;
                }
                if (rk == "storageId") {
                    let v = r.read_str();
                    if (!r.failed()) {
                        storage_id = v;
                    }
                } else if (rk == "created") {
                    created = r.read_bool();
                } else {
                    r.skip_value();
                }
            }
            r.end_object();
        } else {
            r.skip_value();
        }
    }
    if (!have_ok) {
        return ConnectReply { ok: false, message: "后台未响应", storage_id: "", created: false };
    }
    return ConnectReply { ok: ok, message: message, storage_id: storage_id, created: created };
}
