entry fn op_s3_test(cx: opaque) -> str {
    let c = opaque::downcast<Ctx>(cx);
    if (c == nil) {
        panic("s3:test: cx is not a Ctx");
    }
    let req = take_request();
    let mut r = JsonReader::of(req);
    if (!enter_args(r)) {
        return err_env("s3: bad s3:test request");
    }
    let mut storage_id: ?str = nil;
    let mut endpoint = "";
    let mut region = "";
    let mut bucket = "";
    let mut access_key_id = "";
    let mut secret_key = "";
    while (r.more()) {
        let k = r.next_key();
        if (r.failed()) {
            return err_env("s3: bad s3:test request");
        }
        when (k) {
            "storageId" -> { storage_id = read_opt_str(r); },
            "endpoint" -> { endpoint = opt_str_or(read_opt_str(r), ""); },
            "region" -> { region = opt_str_or(read_opt_str(r), ""); },
            "bucket" -> { bucket = opt_str_or(read_opt_str(r), ""); },
            "accessKeyId" -> { access_key_id = opt_str_or(read_opt_str(r), ""); },
            "secretAccessKey" -> { secret_key = opt_str_or(read_opt_str(r), ""); },
            else -> { r.skip_value(); },
        }
        if (r.failed()) {
            return err_env("s3: bad s3:test request");
        }
    }
    r.end_object();
    let outcome = test_impl(TestArgs {
        storage_id: storage_id,
        endpoint: endpoint,
        region: region,
        bucket: bucket,
        access_key_id: access_key_id,
        secret_key: secret_key,
    });
    let mut w = JsonWriter::new();
    w.begin_object();
    w.key("result");
    w.write_str(outcome);
    w.end_object();
    return ok_env(w.finish());
}

entry fn op_s3_connect(cx: opaque) -> str {
    let c = opaque::downcast<Ctx>(cx);
    if (c == nil) {
        panic("s3:connect: cx is not a Ctx");
    }
    let req = take_request();
    let mut r = JsonReader::of(req);
    if (!enter_args(r)) {
        return err_env("s3: bad s3:connect request");
    }
    let mut storage_id: ?str = nil;
    let mut endpoint = "";
    let mut region = "";
    let mut bucket = "";
    let mut alias = "";
    let mut access_key_id = "";
    let mut secret_key = "";
    while (r.more()) {
        let k = r.next_key();
        if (r.failed()) {
            return err_env("s3: bad s3:connect request");
        }
        when (k) {
            "storageId" -> { storage_id = read_opt_str(r); },
            "endpoint" -> { endpoint = opt_str_or(read_opt_str(r), ""); },
            "region" -> { region = opt_str_or(read_opt_str(r), ""); },
            "bucket" -> { bucket = opt_str_or(read_opt_str(r), ""); },
            "alias" -> { alias = opt_str_or(read_opt_str(r), ""); },
            "accessKeyId" -> { access_key_id = opt_str_or(read_opt_str(r), ""); },
            "secretAccessKey" -> { secret_key = opt_str_or(read_opt_str(r), ""); },
            else -> { r.skip_value(); },
        }
        if (r.failed()) {
            return err_env("s3: bad s3:connect request");
        }
    }
    r.end_object();
    let out = connect_impl(ConnectArgs {
        storage_id: storage_id,
        endpoint: endpoint,
        region: region,
        bucket: bucket,
        alias: alias,
        access_key_id: access_key_id,
        secret_key: secret_key,
    });
    let o = out.0;
    if (o == nil) {
        let mut msg = out.1;
        if (msg == "") {
            msg = "s3: connect failed";
        }
        return err_env(msg);
    }
    let res: str = o;
    return ok_env(res);
}
