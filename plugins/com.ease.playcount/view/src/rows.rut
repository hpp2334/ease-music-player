// rows.rut — the ranked list + the status bodies. One `Each` item is a
// plain per-build view over the item JSON: `Each` rebuilds the mounted
// rows whenever the entries atom changes, so the podium reskin, the bar
// scale and the covers swap all land on the next refresh. The density
// change between the podium (1–3) and the tail (4+) IS the separator — a
// taller gap after rank 3, no hairline.

use tur_kit::control_flow::control::{ Condition, Each };
use tur_kit::flags::{ Align, Axis, BorderPosition, BoxFit, CrossAlign, MainAlign, MainAxisSize };
use tur_kit::handles::{ MapHandle, View, str_parse_f64, value_len };
use tur_kit::image::{ Image };
use tur_kit::layout::box::{ Container, SizedBox };
use tur_kit::layout::flex::{ Column, Expanded, Row };
use tur_kit::reactive::{ DeriveCtx, Readable, Source, derive, sv };
use tur_kit::scroll::{ ScrollView };
use tur_kit::text::core::{ Text };

/// The ready body: the "TOP n" caption (only when there IS a tail below
/// the podium — with ≤3 cards the medals already tell the whole story)
/// over the ranked rows.
pub fn ready_body(entries: Source<opaque>, covers_map: MapHandle) -> View {
    let has_tail: Readable<bool> = derive<bool>(fn (ctx: DeriveCtx) -> bool {
        return value_len(ctx.get<opaque>(entries)) > 3;
    });
    let top_label: Readable<str> = derive<str>(fn (ctx: DeriveCtx) -> str {
        let n = value_len(ctx.get<opaque>(entries));
        let m: u64 = 3;
        if (n < m) {
            m = n;
        }
        return f"TOP {m}";
    });
    return ScrollView()
        .axis(Axis::Vertical)
        .child(
            Column()
                .cross_alignment(CrossAlign::Stretch)
                .main_axis_size(MainAxisSize::Min)
                .child(
                    Condition(has_tail)
                        .then(Text().text(top_label).font_size(11.0).color(theme::TEXT_MUTED).build())
                        .else_branch(SizedBox(0.0, 0.0).build())
                        .build(),
                )
                .child(SizedBox(0.0, 8.0).build())
                .child(
                    Each(entries)
                        .item_builder(fn (i: u64, item: str) -> View {
                            return entry_column(i, item, covers_map);
                        })
                        .build(),
                )
                .child(SizedBox(0.0, 24.0).build())
                .build(),
        )
        .build();
}

/// One `Each` item.
fn entry_column(i: u64, item: str, covers_map: MapHandle) -> View {
    if (i == 0) {
        return Column()
            .cross_alignment(CrossAlign::Stretch)
            .main_axis_size(MainAxisSize::Min)
            .child(ranked_row(i, item, covers_map))
            .build();
    }
    let gap: f64 = if (i == 3) { 24.0 } else { 12.0 };
    return Column()
        .cross_alignment(CrossAlign::Stretch)
        .main_axis_size(MainAxisSize::Min)
        .child(SizedBox(0.0, gap).build())
        .child(ranked_row(i, item, covers_map))
        .build();
}

/// One ranked row — rank `i + 1`. Everything data- or rank-dependent is
/// read off the item JSON at build time. The medal spec (the TS
/// `medalSpec`): top 3 get podium discs, the tail a small muted disc. The
/// medal is the ONLY tier-colored element on a card. Hierarchy is
/// expressed via size + color contrast (podium dark, tail muted) plus the
/// medal — no bold weight, per the TS note.
fn ranked_row(i: u64, item: str, covers_map: MapHandle) -> View {
    let e = stats::decode_entry(item);
    if (e == nil) {
        return SizedBox(0.0, 0.0).build();
    }
    let ent: stats::EntryV = e;
    let rank = i + 1;
    let tier = rank <= 3;

    let d: f64 = 28.0;
    let fill: u64 = theme::BAR_TRACK;
    let ring: u64 = theme::BAR_TRACK;
    let num: u64 = theme::TEXT_MUTED;
    let fs: f64 = 12.0;
    let bw: f64 = 1.0;
    if (rank == 1) {
        d = 48.0;
        fill = theme::GOLD;
        ring = theme::GOLD_RING;
        num = theme::GOLD_NUM;
        fs = 18.0;
        bw = 2.0;
    } else if (rank == 2) {
        d = 44.0;
        fill = theme::SILVER;
        ring = theme::SILVER_RING;
        num = theme::SILVER_NUM;
        fs = 16.0;
        bw = 2.0;
    } else if (rank == 3) {
        d = 44.0;
        fill = theme::BRONZE;
        ring = theme::BRONZE_RING;
        num = theme::BRONZE_NUM;
        fs = 16.0;
        bw = 1.0;
    }
    let badge = Container()
        .width_height(d, d)
        .alignment(Align::Center)
        .color(sv(fill))
        .border(ring, bw, BorderPosition::Inside)
        .radius(sv(d / 2.0))
        .child(Text().text(sv(f"{rank}")).font_size(fs).color(num).build())
        .build();

    let title_color: u64 = if (tier) { theme::TEXT } else { theme::TEXT_MUTED };
    let title_size: f64 = if (tier) { 16.0 } else { 14.0 };
    let inner_pad: f64 = if (tier) { 16.0 } else { 12.0 };
    let title = Expanded()
        .child(
            Text()
                .text(sv(ent.title))
                .font_size(title_size)
                .color(title_color)
                .max_lines(1)
                .ellipsis()
                .build(),
        )
        .build();

    // Bar + count read as ONE glance: fill/track flexes keep their ratio
    // and the exact count sits right at the bar's end.
    let fill_flex: f64 = ent.count as f64;
    let track: i64 = ent.top - ent.count;
    let track_flex: f64 = if (track > 0) { track as f64 } else { 0.0 };
    let bar = Row()
        .cross_alignment(CrossAlign::Center)
        .child(
            Expanded()
                .flex(sv(fill_flex))
                .child(Container().height(sv(6.0f64)).color(sv(theme::PRIMARY)).radius(sv(3.0f64)).build())
                .build(),
        )
        .child(
            Expanded()
                .flex(sv(track_flex))
                .child(Container().height(sv(6.0f64)).color(sv(theme::BAR_TRACK)).radius(sv(3.0f64)).build())
                .build(),
        )
        .child(SizedBox(8.0, 0.0).build())
        .child(Text().text(sv(f"{ent.count}")).font_size(12.0).color(theme::TEXT_MUTED).build())
        .build();

    let card = Container()
        .color(sv(theme::CARD))
        .radius(sv(12.0f64))
        .shadow(theme::SHADOW, 6.0, 0.0, 2.0)
        .child(
            Container()
                .padding(inner_pad)
                .child(
                    Column()
                        .cross_alignment(CrossAlign::Stretch)
                        .main_axis_size(MainAxisSize::Min)
                        .child(
                            Row()
                                .main_alignment(MainAlign::Start)
                                .cross_alignment(CrossAlign::Center)
                                .child(badge)
                                .child(SizedBox(12.0, 0.0).build())
                                .child(cover_thumb(ent.music_id, covers_map))
                                .child(SizedBox(12.0, 0.0).build())
                                .child(title)
                                .build(),
                        )
                        .child(SizedBox(0.0, 8.0).build())
                        .child(bar)
                        // Breathing room under the bar so it doesn't hug
                        // the card's bottom edge.
                        .child(SizedBox(0.0, 3.0).build())
                        .build(),
                )
                .build(),
        )
        .build();
    return card;
}

/// The cover thumbnail: the host-registered image resource at a fixed
/// square slot, or the fallback disc (tonal track + note glyph) while the
/// id hasn't landed / for tracks with no cover.
fn cover_thumb(music_id: str, covers_map: MapHandle) -> View {
    let res = str_parse_f64(covers_map.get(music_id)) as u64;
    if (res != 0) {
        return Container()
            .width_height(theme::COVER_SIZE, theme::COVER_SIZE)
            .color(sv(theme::BAR_TRACK))
            .radius(sv(10.0f64))
            .child(
                Image(res)
                    .width(theme::COVER_SIZE)
                    .height(theme::COVER_SIZE)
                    .fit(BoxFit::Cover)
                    .build(),
            )
            .build();
    }
    return Container()
        .width_height(theme::COVER_SIZE, theme::COVER_SIZE)
        .alignment(Align::Center)
        .color(sv(theme::BAR_TRACK))
        .radius(sv(10.0f64))
        .child(Text().text(sv("♪")).font_size(18.0).color(theme::PRIMARY_TINT).build())
        .build();
}

// ---------------------------------------------------------------------------
// Status bodies
// ---------------------------------------------------------------------------

pub fn loading_body() -> View {
    return Container()
        .padding(48.0)
        .child(Text().text(sv("Loading…")).font_size(14.0).color(theme::TEXT_MUTED).build())
        .build();
}

/// An intentional resting state: a tonal disc carrying the note glyph, the
/// message, and a short hint.
pub fn empty_body() -> View {
    return Column()
        .cross_alignment(CrossAlign::Center)
        .main_alignment(MainAlign::Center)
        .child(
            Container()
                .width_height(88.0, 88.0)
                .alignment(Align::Center)
                .color(sv(theme::CARD))
                .radius(sv(44.0f64))
                .child(Text().text(sv("♪")).font_size(34.0).color(theme::PRIMARY_TINT).build())
                .build(),
        )
        .child(SizedBox(0.0, 16.0).build())
        .child(Text().text(sv("No plays in this range.")).font_size(14.0).color(theme::TEXT).build())
        .child(SizedBox(0.0, 4.0).build())
        .child(Text().text(sv("Try a wider range.")).font_size(12.0).color(theme::TEXT_MUTED).build())
        .build();
}
