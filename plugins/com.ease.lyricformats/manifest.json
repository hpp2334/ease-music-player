{
  "id": "com.ease.lyricformats",
  "name": { "en-US": "Lyric Formats", "zh-CN": "歌词格式" },
  "version": "0.2.1",
  "apiVersion": 1,
  "description": {
    "en-US": "Lyric file parsers for LRC, SRT and WebVTT. The app's lyric pane is powered entirely by this plugin — there is no built-in parser.",
    "zh-CN": "LRC、SRT、WebVTT 歌词文件解析器。应用的歌词显示完全由本插件驱动，应用内没有内置解析器。"
  },
  "author": "ease",
  "backend": "backend.js",
  "events": [],
  "contributions": {
    "lyricParsers": [
      {
        "id": "lrc",
        "title": { "en-US": "LRC", "zh-CN": "LRC" },
        "desc": {
          "en-US": "The classic synced-lyrics format",
          "zh-CN": "经典逐行歌词格式"
        },
        "extensions": ["lrc"]
      },
      {
        "id": "subtitle",
        "title": { "en-US": "SRT / WebVTT", "zh-CN": "SRT / WebVTT" },
        "desc": {
          "en-US": "Generic subtitle files",
          "zh-CN": "通用字幕文件"
        },
        "extensions": ["srt", "vtt"]
      }
    ]
  }
}
