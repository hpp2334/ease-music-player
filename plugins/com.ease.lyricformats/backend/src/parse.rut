// parse.rut — the `lyric:parse` op on the BINARY lane: the bound handler
// decodes its OWN framing (raw bytes — the op owns its schema):
//
//   <JSON header>\n<content bytes>
//
// The header is one compact JSON object (`parserId`, `fileName` — its
// string values never contain a literal newline, so the FIRST \n byte
// ends it); the content is the raw lyric bytes. The whole payload is
// decoded lossily as UTF-8 (`tur_host::clipboard::decode_utf8`) and the
// split rides STR ops — no bytes slicing anywhere (lyric formats are
// text). The answer is the RAW payload (`{lines, metadata}`, built in
// result.rut, encoded UTF-8 back over `encode_utf8`) or nil = "not
// mine"; a malformed request is the plugin's own failure — a trap the
// host's envelope turns into the error arm (logged, next parser tried),
// exactly like the thrown decode error did in the JS backend.

use json::{ JsonReader };
use lrc::{ parse_lrc };
use result::{ LyricResult, write_result };
use srt::{ parse_srt };
use text::{ file_ext_lower, index_of, split_lines, strip_bom };
use tur_host::clipboard::{ decode_utf8, encode_utf8 };
use vtt::{ parse_vtt };

// The header fields this op reads; unknown keys (`size`, …) are skipped,
// never a failure.
struct Req {
    parser_id: str,
    file_name: str,
}

pub fn lyric_parse_bin(args: bytes) -> ?bytes {
    let all = decode_utf8(args);
    // The first \n ends the header; the rest is the content text. An
    // unframed payload (no newline) is the host's own bug — a trap.
    let nl = index_of(all, 0x0A, 0);
    if (nl < 0) {
        panic("lyric:parse: unframed payload (missing header newline)");
    }
    let header = all.slice(0, nl);
    let text = all.slice(nl + 1, all.len());
    let req = decode_request(header);
    if (req == nil) {
        panic("lyric:parse: malformed header");
    }
    let r: Req = req;
    let parsed: ?LyricResult = dispatch_parser(r.parser_id, r.file_name, text);
    if (parsed == nil) {
        // Unknown parser/extension or no usable content — "not mine",
        // the nil answer the host falls through on.
        return nil;
    }
    let res: LyricResult = parsed;
    return encode_utf8(write_result(res));
}

// Pick the lexer: the manifest's parserId first ("lrc" / "subtitle"),
// the file-name extension as the fallback key (the old dispatch's key,
// kept for an unrecognized id).
fn dispatch_parser(parser_id: str, file_name: str, text: str) -> ?LyricResult {
    if (parser_id == "lrc") {
        return parse_lrc(text);
    }
    if (parser_id == "subtitle") {
        return dispatch_subtitle(file_name, text);
    }
    let ext = file_ext_lower(file_name);
    if (ext == "lrc") {
        return parse_lrc(text);
    }
    if (ext == "srt" || ext == "vtt") {
        return dispatch_subtitle(file_name, text);
    }
    return nil;
}

// The subtitle family (manifest id "subtitle", extensions srt + vtt):
// by extension, and for an extension-less name the WEBVTT header sniff
// (the old single walk's own classification).
fn dispatch_subtitle(file_name: str, text: str) -> ?LyricResult {
    let ext = file_ext_lower(file_name);
    if (ext == "srt") {
        return parse_srt(text);
    }
    if (ext == "vtt") {
        return parse_vtt(text);
    }
    if (has_vtt_header(text)) {
        return parse_vtt(text);
    }
    return parse_srt(text);
}

fn has_vtt_header(text: str) -> bool {
    let rows = split_lines(strip_bom(text));
    if (rows.len == 0) {
        return false;
    }
    let r0: str = rows[0];
    return r0.starts_with(0, "WEBVTT");
}

// Decode the raw header object — only the fields this op reads; unknown
// keys are skipped, never a failure. Nil on any malformed shape.
fn decode_request(header: str) -> ?Req {
    let r = JsonReader::of(header);
    let parser_id = "";
    let file_name = "";
    r.begin_object();
    while (r.more()) {
        let k = r.next_key();
        if (r.failed()) { return nil; }
        if (k == "parserId") {
            parser_id = r.read_str();
        } else if (k == "fileName") {
            file_name = r.read_str();
        } else {
            r.skip_value();
        }
        if (r.failed()) { return nil; }
    }
    r.end_object();
    if (r.failed()) { return nil; }
    return Req { parser_id: parser_id, file_name: file_name };
}
