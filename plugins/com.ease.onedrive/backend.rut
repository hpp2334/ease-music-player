entry fn op_oauth_url(cx: opaque) -> str {
    let c = opaque::downcast<Ctx>(cx);
    if (c == nil) {
        panic("oauth:url: cx is not a Ctx");
    }
    let req = take_request();
    let mut r = JsonReader::of(req);
    if (!enter_args(r)) {
        return err_env("onedrive: bad oauth:url request");
    }
    // the host's (pluginId, oauthId) pair rides the payload; the authorize
    // URL is flow-independent
    while (r.more()) {
        r.next_key();
        if (r.failed()) {
            return err_env("onedrive: bad oauth:url request");
        }
        r.skip_value();
    }
    let mut w = JsonWriter::new();
    w.begin_object();
    w.key("url");
    w.write_str(authorize_url());
    w.end_object();
    return ok_env(w.finish());
}

entry fn op_oauth_exchange(cx: opaque) -> str {
    let c = opaque::downcast<Ctx>(cx);
    if (c == nil) {
        panic("oauth:exchange: cx is not a Ctx");
    }
    let mut cc: Ctx = c;
    let req = take_request();
    let mut r = JsonReader::of(req);
    if (!enter_args(r)) {
        return err_env("onedrive: bad oauth:exchange request");
    }
    let mut oauth_id: ?str = nil;
    let mut code: ?str = nil;
    while (r.more()) {
        let k = r.next_key();
        if (r.failed()) {
            return err_env("onedrive: bad oauth:exchange request");
        }
        when (k) {
            "oauthId" -> { oauth_id = read_opt_str(r); },
            "code" -> { code = read_opt_str(r); },
            else -> { r.skip_value(); },
        }
        if (r.failed()) {
            return err_env("onedrive: bad oauth:exchange request");
        }
    }
    if (oauth_id == nil || code == nil) {
        return err_env("onedrive: oauth:exchange needs oauthId + code");
    }
    let oid: str = oauth_id;
    let cd: str = code;
    let out = exchange_impl(cc, cd, oid);
    let o = out.0;
    if (o == nil) {
        return err_env(out.1);
    }
    let id: str = o;
    let mut w = JsonWriter::new();
    w.begin_object();
    w.key("storageId");
    w.write_str(id);
    w.end_object();
    return ok_env(w.finish());
}
