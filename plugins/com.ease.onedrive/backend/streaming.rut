// backend/streaming.rut — the chunked-PULL stream sessions (storage:get /
// get-chunk / release). `storage:get` opens with ONE metadata GET (the
// documented path-addressed driveItem read establishes the working auth +
// `{name, size, file.mimeType}`) and parks the session under a fresh
// `sid`; each chunk is an independently-authed ranged GET
// `offset..offset+len-1` on the `/content` endpoint until one answers
// `eof`. OneDrive honors Range, so the opener declares
// `dataOffset = offset` (the host's prefix-drop path stays idle). A 416
// (the pull landed past EOF — the exact-multiple tail) is the clean end
// of the stream, not a failure.
//
// Sessions rode the old start-answer record; the new contract has no
// start answer, so the pool serializes into the plugin KV (`Db`) under
// `sessions` — `{"next":<u64>,"slots":[{sid,inst,path},…]}` (4 slots + the
// sid allocator). A slot parked by a killed process is evicted
// oldest-first when the pool runs full (a dead session must never wedge
// new streams — the adaptation from the old in-memory pool's
// "too many concurrent streams" error, whose slots could never clear
// across a process restart).
//
// The chunk's failure arm frees the session first (the old behavior: a
// broken stream never stays parked), then traps with the marked error.

use crypto::{ b64_encode };
use emp::{ Db, Secret };
use json::{ JsonReader, JsonWriter };
use strutil::{ encode_graph_path, last_segment };
use tokens::{ graph_call };
use tur_host::clipboard::{ decode_utf8 };

// the Graph API base — the same literal as listing.rut's
// `ONEDRIVE_ROOT_API` (top-level lets don't share across sibling modules;
// the name stays unique tree-wide).
let GRAPH_ROOT: str = "https://graph.microsoft.com/v1.0/me/drive";

// 4 concurrent stream sessions are ample (the host pulls sequentially per
// stream).
let SESS_POOL: i32 = 4;

let POOL_KEY: str = "sessions";

/// A parked stream session (the pool slot's columns as one value).
struct Session {
    instance: str,
    path: str,
}

/// The pool, decoded into parallel columns (the old Ctx shape — fixed 4
/// slots, `sids[i] == 0` = free).
struct Pool {
    sids: [u64],
    insts: [?str],
    paths: [?str],
    next_sid: u64,
}

fn pool_new() -> Pool {
    return Pool {
        sids: [0; 4],
        insts: [nil; 4],
        paths: [nil; 4],
        next_sid: 1,
    };
}

/// Load the persisted pool (a missing/corrupt document decodes as empty —
/// the sessions are re-openable, never worth failing an op over).
fn pool_of(db: Db) -> Pool {
    let p = pool_new();
    let raw = db.get(POOL_KEY);
    if (raw == nil) {
        return p;
    }
    let doc: str = raw;
    let r = JsonReader::of(doc);
    r.begin_object();
    while (r.more()) {
        let k = r.next_key();
        if (r.failed()) {
            return pool_new();
        }
        if (k == "next") {
            p.next_sid = r.read_i64() as u64;
        } else if (k == "slots") {
            r.begin_array();
            while (r.more()) {
                walk_slot(r, p);
            }
            r.end_array();
        } else {
            r.skip_value();
        }
        if (r.failed()) {
            return pool_new();
        }
    }
    r.end_object();
    if (r.failed()) {
        return pool_new();
    }
    return p;
}

/// One persisted slot el: `{sid, inst, path}` — claimed into the first
/// free column (over-long persisted pools just drop their tail; sids
/// still advance past them).
fn walk_slot(r: JsonReader, p: Pool) {
    r.begin_object();
    let sid: u64 = 0;
    let inst: ?str = nil;
    let path: ?str = nil;
    while (r.more()) {
        let k = r.next_key();
        if (r.failed()) {
            return;
        }
        if (k == "sid") {
            sid = r.read_i64() as u64;
        } else if (k == "inst") {
            inst = read_slot_str(r);
        } else if (k == "path") {
            path = read_slot_str(r);
        } else {
            r.skip_value();
        }
    }
    r.end_object();
    if (r.failed() || sid == 0) {
        return;
    }
    if (p.next_sid <= sid) {
        p.next_sid = sid + 1u64;
    }
    let slot = free_slot_of(p);
    if (slot == -1) {
        return;
    }
    p.sids[slot] = sid;
    p.insts[slot] = inst;
    p.paths[slot] = path;
}

fn pool_save(db: Db, p: Pool) {
    let w = JsonWriter::new();
    w.begin_object();
    w.key("next");
    w.write_i64(p.next_sid as i64);
    w.key("slots");
    w.begin_array();
    let i: i32 = 0;
    while (i < SESS_POOL) {
        if (p.sids[i] != 0) {
            w.begin_object();
            w.key("sid");
            w.write_i64(p.sids[i] as i64);
            write_slot_str(w, "inst", p.insts[i]);
            write_slot_str(w, "path", p.paths[i]);
            w.end_object();
        }
        i += 1;
    }
    w.end_array();
    w.end_object();
    db.set(POOL_KEY, w.finish());
}

fn write_slot_str(w: JsonWriter, key: str, v: ?str) {
    w.key(key);
    if (v == nil) {
        w.write_raw("\"\"");
    } else {
        let s: str = v;
        w.write_str(s);
    }
}

/// Read one slot member as a str (absent/invalid = nil).
fn read_slot_str(r: JsonReader) -> ?str {
    if (r.try_null()) {
        return nil;
    }
    let v = r.read_str();
    if (r.failed()) {
        return nil;
    }
    return v;
}

/// First slot index with `sids[i] == 0`, else -1.
fn free_slot_of(p: Pool) -> i32 {
    let i: i32 = 0;
    while (i < SESS_POOL) {
        if (p.sids[i] == 0) {
            return i;
        }
        i += 1;
    }
    return -1;
}

/// Lowest live sid (the oldest session — the eviction victim).
fn lowest_sid(p: Pool) -> u64 {
    let best: u64 = 0;
    let i: i32 = 0;
    while (i < SESS_POOL) {
        let s = p.sids[i];
        if (s != 0) {
            if (best == 0 || s < best) {
                best = s;
            }
        }
        i += 1;
    }
    return best;
}

fn clear_slot(p: Pool, i: i32) {
    p.sids[i] = 0;
    p.insts[i] = nil;
    p.paths[i] = nil;
}

/// Claim a slot for `sid`, evicting the oldest session when the pool runs
/// full (a slot parked by a killed process must never wedge new streams).
fn claim_slot(p: Pool, sid: u64) -> i32 {
    let slot = free_slot_of(p);
    if (slot == -1) {
        let victim = lowest_sid(p);
        let i: i32 = 0;
        while (i < SESS_POOL) {
            if (p.sids[i] == victim) {
                clear_slot(p, i);
                slot = i;
                break;
            }
            i += 1;
        }
    }
    p.sids[slot] = sid;
    return slot;
}

fn session_of(p: Pool, sid: u64) -> ?Session {
    let i: i32 = 0;
    while (i < SESS_POOL) {
        if (sid != 0 && p.sids[i] == sid) {
            let inst = p.insts[i];
            let pth = p.paths[i];
            if (inst != nil && pth != nil) {
                let i2: str = inst;
                let p2: str = pth;
                return Session { instance: i2, path: p2 };
            }
            return nil;
        }
        i += 1;
    }
    return nil;
}

// ---------------------------------------------------------------------------
// the three ops
// ---------------------------------------------------------------------------

/// Open a stream: one metadata GET establishes the working auth + the
/// session, parked under a fresh `sid`. Answers the opener document
/// `{sid, meta:{...}}`; traps with the marked error on any failure.
pub fn open_impl(db: Db, secret: Secret, instance: str, path: str, offset: u64) -> str {
    let url = f"{GRAPH_ROOT}/root:{encode_graph_path(path)}";
    let resp = graph_call(db, secret, instance, "GET", url, nil, nil);
    if (resp.failed) {
        panic(resp.err);
    }
    let text = decode_utf8(resp.body);
    let meta = decode_meta(text);
    if (meta == nil) {
        panic("onedrive: unparsable metadata response");
    }
    let m: Meta = meta;
    // claim a session slot (evicting the oldest when full)
    let p = pool_of(db);
    let sid = p.next_sid;
    p.next_sid = p.next_sid + 1u64;
    let slot = claim_slot(p, sid);
    p.insts[slot] = instance;
    p.paths[slot] = path;
    pool_save(db, p);
    let name = m.name;
    if (name == "") {
        name = last_segment(path);
    }
    let w = JsonWriter::new();
    w.begin_object();
    w.key("sid");
    w.write_i64(sid as i64);
    w.key("meta");
    w.begin_object();
    if (m.size >= 0) {
        w.key("totalLength");
        w.write_i64(m.size);
    }
    w.key("name");
    w.write_str(name);
    if (m.mime != "") {
        w.key("contentType");
        w.write_str(m.mime);
    }
    w.key("dataOffset");
    w.write_i64(offset as i64);
    w.end_object();
    w.end_object();
    return w.finish();
}

/// The opener's driveItem: `name` / `size` / `file.mimeType` (+ a `folder`
/// facet tolerated for a mis-pathed dir). Nil on any malformed shape.
fn decode_meta(doc: str) -> ?Meta {
    let r = JsonReader::of(doc);
    r.begin_object();
    let name: ?str = nil;
    let size: i64 = -1;
    let mime: ?str = nil;
    while (r.more()) {
        let k = r.next_key();
        if (r.failed()) {
            return nil;
        }
        when (k) {
            "name" -> {
                let v = r.read_str();
                if (r.failed()) { return nil; }
                name = v;
            },
            "size" -> { size = r.read_i64(); },
            "file" -> {
                if (!r.try_null()) {
                    r.begin_object();
                    while (r.more()) {
                        let fk = r.next_key();
                        if (r.failed()) { return nil; }
                        if (fk == "mimeType") {
                            let v = r.read_str();
                            if (r.failed()) { return nil; }
                            mime = v;
                        } else {
                            r.skip_value();
                        }
                    }
                    r.end_object();
                    if (r.failed()) { return nil; }
                }
            },
            else -> { r.skip_value(); },
        }
        if (r.failed()) {
            return nil;
        }
    }
    r.end_object();
    if (r.failed()) {
        return nil;
    }
    let n = "";
    if (name != nil) {
        n = name;
    }
    let m = "";
    if (mime != nil) {
        m = mime;
    }
    return Meta { name: n, size: size, mime: m };
}

/// The opener's metadata (the driveItem fields the session needs).
struct Meta {
    name: str,
    size: i64,
    mime: str,
}

/// One chunk: a ranged GET `offset..offset+len-1` on the `/content`
/// endpoint; `eof` when fewer bytes than `len` came back (the final chunk
/// carries data AND eof). The 401 rotation rides `graph_call`. A failure
/// frees the session first, then traps with the marked error.
pub fn chunk_impl(db: Db, secret: Secret, sid: u64, offset: u64, len: u64) -> str {
    let p = pool_of(db);
    let sess = session_of(p, sid);
    if (sess == nil) {
        panic("onedrive: unknown stream session");
    }
    let s: Session = sess;
    let end = offset + len - 1u64;
    let url = f"{GRAPH_ROOT}/root:{encode_graph_path(s.path)}:/content";
    let resp = graph_call(db, secret, s.instance, "GET", url, f"bytes={offset}-{end}", nil);
    if (resp.failed) {
        release_impl(db, sid);
        panic(resp.err);
    }
    // 416 = the pull landed past EOF (exact-multiple-of-len files): the
    // stream is done, not failed.
    if (resp.status == 416) {
        return chunk_json("", true);
    }
    let data = resp.body;
    let n = data.len();
    let eof = (n as u64) < len;
    return chunk_json(b64_encode(data), eof);
}

fn chunk_json(data_b64: str, eof: bool) -> str {
    let w = JsonWriter::new();
    w.begin_object();
    w.key("data");
    w.write_str(data_b64);
    w.key("eof");
    w.write_bool(eof);
    w.end_object();
    return w.finish();
}

/// Free a session slot. True when the sid was live.
pub fn release_impl(db: Db, sid: u64) -> bool {
    let p = pool_of(db);
    let i: i32 = 0;
    while (i < SESS_POOL) {
        if (sid != 0 && p.sids[i] == sid) {
            clear_slot(p, i);
            pool_save(db, p);
            return true;
        }
        i += 1;
    }
    return false;
}
